from pathlib import Path
import csv

SPLIT = "val"  # train / val / test
LABEL = 1
LABEL_NAME = "abnormal"

BASE_DIR = Path(r"C:\Users\a4525\Dataset\behavior\val\abnormal\frames")
OUTPUT_FILE = Path(r"C:\Users\a4525\Dataset\behavior\val\abnormal\labels\labels.csv")

IMAGE_EXTENSIONS = [".jpg", ".jpeg", ".png", ".bmp", ".webp"]


def main():
    if not BASE_DIR.exists():
        print(f"폴더 없음: {BASE_DIR}")
        return

    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)

    files = [
        f for f in BASE_DIR.iterdir()
        if f.is_file() and f.suffix.lower() in IMAGE_EXTENSIONS
    ]

    total = len(files)
    print(f"라벨링 대상 이미지 수: {total}")

    success_count = 0
    error_count = 0

    with open(OUTPUT_FILE, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.writer(f)
        writer.writerow(["file_path", "label", "label_name"])

        for idx, file in enumerate(files, start=1):
            try:
                writer.writerow([
                    str(file).replace("\\", "/"),
                    LABEL,
                    LABEL_NAME
                ])
                success_count += 1

                if idx % 1000 == 0:
                    print(f"진행 중: {idx}/{total}")

            except Exception as e:
                error_count += 1
                print(f"[오류] {file} - {e}")

    print("라벨링 완료")
    print(f"성공: {success_count}")
    print(f"오류: {error_count}")
    print(f"저장 위치: {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
